{
  "name": "crates-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "rm -rf .assets && mkdir -p .assets && cp -R ../crates-frontend/dist/crates-frontend-v2/. .assets/ && cp -R ../crates-public/static .assets/static",
    "dev": "npm run build:assets && wrangler dev",
    "deploy": "npm run build:assets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply crates --local",
    "db:migrate:remote": "wrangler d1 migrations apply crates --remote",
    "db:export": "node scripts/export-pg-to-d1.mjs"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "pg": "^8",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
