{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crates",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker, two hostnames:
  //   app.crates.music -> Angular SPA (static assets) + JSON API under /api/v1/* and /v1/*
  //   crates.music     -> server-rendered public pages (replaces crates-public Go service)
  // run_worker_first is true because asset serving would otherwise shadow the SSR site's
  // routes on crates.music; the worker decides by hostname and calls env.ASSETS itself.
  // .assets is staged by `npm run build:assets`: Angular dist + crates-public/static.
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crates",
      // Live database on the account (wrangler d1 info crates).
      "database_id": "64a5d963-e269-4977-b064-66eb44f89c43",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      // Live namespace on the account (wrangler kv namespace list).
      "id": "cae8644b7e7f42dead23b5dad24ec504"
    }
  ],

  // Secrets (wrangler secret put / .dev.vars): SPOTIFY_CLIENT_ID,
  // SPOTIFY_CLIENT_SECRET, CRATES_ENCRYPTION_KEY.
  //
  // Spotify only allows loopback redirect URIs as IP literals (127.0.0.1, not
  // localhost) or HTTPS, which is why the dev override in .dev.vars uses 127.0.0.1.
  //
  // These are the PRODUCTION values — they are what `wrangler deploy` ships.
  // Local dev overrides them from .dev.vars, so nothing here points at localhost;
  // a deploy that accidentally shipped a loopback redirect URI would break login.
  // Every redirect URI here must also be registered in the Spotify app.
  "vars": {
    "SPOTIFY_REDIRECT_URI": "https://app.crates.music/api/v1/auth/callback",
    "CRATES_AUTH_CALLBACK_URI": "https://app.crates.music/auth/callback",
    "CRATES_MCP_BASE_URL": "https://app.crates.music",
    "CRATES_MCP_REDIRECT_URI": "https://app.crates.music/mcp/auth/callback"
  },

  "triggers": {
    // Hourly: trending recompute + MCP key cleanup
    "crons": ["0 * * * *"]
  },

  "workflows": [
    {
      "name": "crates-library-sync",
      "binding": "LIBRARY_SYNC",
      "class_name": "LibrarySyncWorkflow"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Keep the *.workers.dev URL alive alongside the custom domains — it is how the
  // parity harness and the login test reach the Worker without touching DNS.
  "workers_dev": true,

  // Cutover, staged one hostname at a time. crates.music is the SSR public site:
  // read-only, no auth, and the one surface that could not be rehearsed on
  // workers.dev (Cloudflare 403s a Host header that doesn't match the hostname).
  //
  // Attaching a custom domain REPLACES the existing DNS record for that hostname,
  // so this is the real flip for crates.music. Rollback: remove the custom domain
  // and restore the A/AAAA records to DigitalOcean's App Platform edge
  // (162.159.140.98, 172.66.0.96 / 2606:4700:7::60, 2a06:98c1:58::60).
  //
  // Still on DigitalOcean until explicitly added here:
  //   { "pattern": "app.crates.music", "custom_domain": true }  <- the API + SPA
  //   { "pattern": "crates.page", "custom_domain": true }       <- zone not on CF yet
  "routes": [
    { "pattern": "crates.music", "custom_domain": true }
  ]
}
