{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crates",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker, two hostnames:
  //   app.crates.music -> Angular SPA (static assets) + JSON API under /api/v1/* and /v1/*
  //   crates.music     -> server-rendered public pages (replaces crates-public Go service)
  // run_worker_first is true because asset serving would otherwise shadow the SSR site's
  // routes on crates.music; the worker decides by hostname and calls env.ASSETS itself.
  // .assets is staged by `npm run build:assets`: Angular dist + crates-public/static.
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crates",
      // Placeholder for local dev. Before first deploy: `wrangler d1 create crates`
      // and paste the real id here.
      "database_id": "64a5d963-e269-4977-b064-66eb44f89c43",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      // Placeholder for local dev. Before first deploy: `wrangler kv namespace create KV`
      // and paste the real id here.
      "id": "cae8644b7e7f42dead23b5dad24ec504"
    }
  ],

  // Secrets (wrangler secret put / .dev.vars): SPOTIFY_CLIENT_ID,
  // SPOTIFY_CLIENT_SECRET, CRATES_ENCRYPTION_KEY.
  // Prod values for these two:
  //   SPOTIFY_REDIRECT_URI = https://app.crates.music/api/v1/auth/callback
  //   CRATES_AUTH_CALLBACK_URI = https://app.crates.music/auth/callback
  // Spotify only allows loopback redirect URIs as IP literals (127.0.0.1, not
  // localhost) or HTTPS. For dev, register http://127.0.0.1:8787/v1/auth/callback
  // in the Spotify app, or override SPOTIFY_REDIRECT_URI in .dev.vars with an
  // ngrok domain pointed at port 8787.
  // Prod values for the MCP pair:
  //   CRATES_MCP_BASE_URL     = https://app.crates.music
  //   CRATES_MCP_REDIRECT_URI = https://app.crates.music/mcp/auth/callback
  // (the redirect must also be registered in the Spotify app)
  "vars": {
    "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8787/v1/auth/callback",
    "CRATES_AUTH_CALLBACK_URI": "http://localhost:4311/auth/callback",
    "CRATES_MCP_BASE_URL": "http://127.0.0.1:8787",
    "CRATES_MCP_REDIRECT_URI": "http://127.0.0.1:8787/mcp/auth/callback"
  },

  "triggers": {
    // Hourly: trending recompute + MCP key cleanup
    "crons": ["0 * * * *"]
  },

  "workflows": [
    {
      "name": "crates-library-sync",
      "binding": "LIBRARY_SYNC",
      "class_name": "LibrarySyncWorkflow"
    }
  ],

  "observability": {
    "enabled": true
  }
  // Phase 5 additions (zone must be on the Cloudflare account):
  // "routes": [
  //   { "pattern": "app.crates.music", "custom_domain": true },
  //   { "pattern": "crates.music", "custom_domain": true },
  //   { "pattern": "crates.page", "custom_domain": true }
  // ]
}
